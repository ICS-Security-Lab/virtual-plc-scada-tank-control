PROGRAM main
  VAR
    T_Fill : TON;
    T_Disch : TON;
    Fill_Seq : BOOL;
    Disch_Seq : BOOL;
    Fill_sec : LREAL;
    Left_Calc : LREAL;
    Disch_sec : LREAL;
    Preset_T : TIME;
    Preset_R : LREAL;
    Preset_R0 : LREAL;
    Step_Lvl : INT;
    Tick : TON;
    Preset_ms : INT;
  END_VAR
  VAR
    Fill_Btn AT %IX0.0 : BOOL;
    Disch_Btn AT %IX0.1 : BOOL;
    Fill_Valve AT %QX0.0 : BOOL;
    Disch_Valve AT %QX0.1 : BOOL;
    Fill_Light AT %QX0.2 : BOOL;
    Timer_Disp AT %QW0 : INT;
    Disch_Light AT %QX0.3 : BOOL;
    Fill_Cmd AT %QX0.4 : BOOL;
    Disch_Cmd AT %QX0.5 : BOOL;
    Preset_s AT %MW1 : INT := 10;
    Level AT %MW0 : INT := 0;
    Fill_Analog AT %QW1 : INT;
    Disch_Analog AT %QW2 : INT;
    Level_Raw AT %IW0 : INT;
    Tank_Level_Raw AT %MW2 : INT := 0;
  END_VAR
  VAR
    _TMP_TIME_TO_S1384184_ENO : BOOL;
    _TMP_TIME_TO_S1384184_OUT : LREAL;
    _TMP_SUB8883323_ENO : BOOL;
    _TMP_SUB8883323_OUT : LREAL;
    _TMP_TO_INT10549693_ENO : BOOL;
    _TMP_TO_INT10549693_OUT : INT;
    _TMP_TIME_TO_S4573589_ENO : BOOL;
    _TMP_TIME_TO_S4573589_OUT : LREAL;
    _TMP_SUB2832327_ENO : BOOL;
    _TMP_SUB2832327_OUT : LREAL;
    _TMP_TO_INT8283863_ENO : BOOL;
    _TMP_TO_INT8283863_OUT : INT;
    _TMP_TO_LREAL9721994_ENO : BOOL;
    _TMP_TO_LREAL9721994_OUT : LREAL;
    _TMP_MOVE2297950_OUT : BOOL;
    _TMP_LIMIT4626533_ENO : BOOL;
    _TMP_LIMIT4626533_OUT : INT;
    _TMP_DIV4995255_ENO : BOOL;
    _TMP_DIV4995255_OUT : INT;
    _TMP_ADD4758243_ENO : BOOL;
    _TMP_ADD4758243_OUT : INT;
    _TMP_SUB3176359_ENO : BOOL;
    _TMP_SUB3176359_OUT : INT;
    _TMP_LIMIT4653345_ENO : BOOL;
    _TMP_LIMIT4653345_OUT : INT;
    _TMP_MUL637669_ENO : BOOL;
    _TMP_MUL637669_OUT : INT;
    _TMP_TO_TIME1275171_ENO : BOOL;
    _TMP_TO_TIME1275171_OUT : TIME;
    _TMP_MOVE3852237_ENO : BOOL;
    _TMP_MOVE3852237_OUT : INT;
    _TMP_MOVE2806209_ENO : BOOL;
    _TMP_MOVE2806209_OUT : INT;
    _TMP_MOVE821481_ENO : BOOL;
    _TMP_MOVE821481_OUT : INT;
    _TMP_MOVE9977675_ENO : BOOL;
    _TMP_MOVE9977675_OUT : INT;
    _TMP_MOVE9460871_ENO : BOOL;
    _TMP_MOVE9460871_OUT : INT;
  END_VAR

  Fill_Seq := NOT(T_Fill.Q) AND NOT(Disch_Seq) AND (Fill_Btn OR Fill_Cmd OR Fill_Seq);
  T_Fill(IN := Fill_Seq, PT := Preset_T);
  Fill_Valve := Fill_Seq;
  Disch_Seq := NOT(T_Disch.Q) AND NOT(Fill_Seq) AND (Disch_Cmd OR Disch_Seq OR NOT(Disch_Btn));
  T_Disch(IN := Disch_Seq, PT := Preset_T);
  Disch_Valve := Disch_Seq;
  Fill_Light := Fill_Seq;
  Disch_Light := Disch_Seq;
  _TMP_TIME_TO_S1384184_OUT := TIME_TO_S(EN := Fill_Seq, IN := T_Fill.ET, ENO => _TMP_TIME_TO_S1384184_ENO);
  IF _TMP_TIME_TO_S1384184_ENO THEN
      Fill_sec := _TMP_TIME_TO_S1384184_OUT;
  END_IF;
  _TMP_SUB8883323_OUT := SUB(EN := Fill_Seq, IN1 := Preset_R, IN2 := Fill_sec, ENO => _TMP_SUB8883323_ENO);
  IF _TMP_SUB8883323_ENO THEN
      Left_Calc := _TMP_SUB8883323_OUT;
  END_IF;
  _TMP_TO_INT10549693_OUT := TO_INT(EN := Fill_Seq, IN := Left_Calc, ENO => _TMP_TO_INT10549693_ENO);
  IF _TMP_TO_INT10549693_ENO THEN
      Timer_Disp := _TMP_TO_INT10549693_OUT;
  END_IF;
  _TMP_TIME_TO_S4573589_OUT := TIME_TO_S(EN := Disch_Seq, IN := T_Disch.ET, ENO => _TMP_TIME_TO_S4573589_ENO);
  IF _TMP_TIME_TO_S4573589_ENO THEN
      Disch_sec := _TMP_TIME_TO_S4573589_OUT;
  END_IF;
  _TMP_SUB2832327_OUT := SUB(EN := Disch_Seq, IN1 := Preset_R, IN2 := Disch_sec, ENO => _TMP_SUB2832327_ENO);
  IF _TMP_SUB2832327_ENO THEN
      Left_Calc := _TMP_SUB2832327_OUT;
  END_IF;
  _TMP_TO_INT8283863_OUT := TO_INT(EN := Disch_Seq, IN := Left_Calc, ENO => _TMP_TO_INT8283863_ENO);
  IF _TMP_TO_INT8283863_ENO THEN
      Timer_Disp := _TMP_TO_INT8283863_OUT;
  END_IF;
  _TMP_TO_LREAL9721994_OUT := TO_LREAL(EN := TRUE, IN := Preset_s, ENO => _TMP_TO_LREAL9721994_ENO);
  IF _TMP_TO_LREAL9721994_ENO THEN
      Preset_R := _TMP_TO_LREAL9721994_OUT;
  END_IF;
  _TMP_MOVE2297950_OUT := MOVE(TRUE);
  _TMP_LIMIT4626533_OUT := LIMIT(EN := TRUE, MN := 1, IN := Preset_s, MX := 30, ENO => _TMP_LIMIT4626533_ENO);
  IF _TMP_LIMIT4626533_ENO THEN
      Preset_s := _TMP_LIMIT4626533_OUT;
  END_IF;
  _TMP_DIV4995255_OUT := DIV(EN := TRUE, IN1 := 100, IN2 := Preset_s, ENO => _TMP_DIV4995255_ENO);
  IF _TMP_DIV4995255_ENO THEN
      Step_Lvl := _TMP_DIV4995255_OUT;
  END_IF;
  Tick(IN := NOT(Tick.Q), PT := T#900ms);
  _TMP_ADD4758243_OUT := ADD(EN := Fill_Seq AND Tick.Q, IN1 := Level, IN2 := Step_Lvl, ENO => _TMP_ADD4758243_ENO);
  IF _TMP_ADD4758243_ENO THEN
      Level := _TMP_ADD4758243_OUT;
  END_IF;
  _TMP_SUB3176359_OUT := SUB(EN := Disch_Seq AND Tick.Q, IN1 := Level, IN2 := Step_Lvl, ENO => _TMP_SUB3176359_ENO);
  IF _TMP_SUB3176359_ENO THEN
      Level := _TMP_SUB3176359_OUT;
  END_IF;
  _TMP_LIMIT4653345_OUT := LIMIT(EN := TRUE, MN := 0, IN := Level, MX := 100, ENO => _TMP_LIMIT4653345_ENO);
  IF _TMP_LIMIT4653345_ENO THEN
      Level := _TMP_LIMIT4653345_OUT;
  END_IF;
  IF Disch_Seq OR Fill_Seq THEN
    Fill_Cmd := FALSE; (*reset*)
  END_IF;
  IF Disch_Seq OR Fill_Seq THEN
    Disch_Cmd := FALSE; (*reset*)
  END_IF;
  _TMP_MUL637669_OUT := MUL(EN := TRUE, IN1 := Preset_s, IN2 := 1000, ENO => _TMP_MUL637669_ENO);
  IF _TMP_MUL637669_ENO THEN
      Preset_ms := _TMP_MUL637669_OUT;
  END_IF;
  _TMP_TO_TIME1275171_OUT := TO_TIME(EN := TRUE, IN := Preset_ms, ENO => _TMP_TO_TIME1275171_ENO);
  IF _TMP_TO_TIME1275171_ENO THEN
      Preset_T := _TMP_TO_TIME1275171_OUT;
  END_IF;
  _TMP_MOVE3852237_OUT := MOVE(EN := Fill_Valve, IN := 1000, ENO => _TMP_MOVE3852237_ENO);
  IF _TMP_MOVE3852237_ENO THEN
      Fill_Analog := _TMP_MOVE3852237_OUT;
  END_IF;
  _TMP_MOVE2806209_OUT := MOVE(EN := NOT(Fill_Valve), IN := 0, ENO => _TMP_MOVE2806209_ENO);
  IF _TMP_MOVE2806209_ENO THEN
      Fill_Analog := _TMP_MOVE2806209_OUT;
  END_IF;
  _TMP_MOVE821481_OUT := MOVE(EN := Disch_Valve, IN := 1000, ENO => _TMP_MOVE821481_ENO);
  IF _TMP_MOVE821481_ENO THEN
      Disch_Analog := _TMP_MOVE821481_OUT;
  END_IF;
  _TMP_MOVE9977675_OUT := MOVE(EN := NOT(Disch_Valve), IN := 0, ENO => _TMP_MOVE9977675_ENO);
  IF _TMP_MOVE9977675_ENO THEN
      Disch_Analog := _TMP_MOVE9977675_OUT;
  END_IF;
  _TMP_MOVE9460871_OUT := MOVE(EN := TRUE, IN := Level_Raw, ENO => _TMP_MOVE9460871_ENO);
  IF _TMP_MOVE9460871_ENO THEN
      Tank_Level_Raw := _TMP_MOVE9460871_OUT;
  END_IF;
END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    TASK task0(INTERVAL := T#100ms,PRIORITY := 1);
    PROGRAM instance0 WITH task0 : main;
  END_RESOURCE
END_CONFIGURATION
